# Beispielwerte – echte Werte nur lokal in der Shell oder im Render-Dashboard setzen.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/tasklist
JDBC_DATABASE_USERNAME=tasklist
JDBC_DATABASE_PASSWORD=<lokales-passwort>
# Adresse des Frontends; mehrere Adressen kommagetrennt
FRONTEND_URL=http://localhost:5173,http://localhost:4173
# Optional: Demo-Daten bei leerer Tabelle anlegen (nie in Produktion)
# SPRING_PROFILES_ACTIVE=demo
# PORT=8080
